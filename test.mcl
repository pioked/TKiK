print("--- 1. Podstawowe zmienne i matematyka ---");
var x = 10;
var y = -5 + 2 * (3 ^ 2);
print(y);

print("--- 2. Stale wbudowane ---");
var promien = 2.0;
var pole_kola = pi * (promien ^ 2);
print(pole_kola);

print("--- 3. Macierze i ich transpozycja ---");
var A = [
    [1, 2],
    [3, 4]
];
var B = [
    [2, 0],
    [1, 2]
];
print(A);
print(B');
print(A * B);

print("--- 4. Warunki i zlozone przypisania ---");
if pole_kola > 10 {
    print("Wieksze od 10");
} else {
    print("Mniejsze lub rowne 10");
}

var stan = true;
if stan and not false {
    print("Logika dziala");
}

x += 5;
print(x);

print("--- 5. Petla FOR oraz CONTINUE ---");
var suma = 0;
for i = 1 to 5 step 1 {
    if i == 3 {
        continue;
    }
    suma = suma + i;
}
print(suma);

print("--- 6. Petla REPEAT UNTIL oraz BREAK ---");
var licznik = 0;
repeat {
    licznik = licznik + 1;
    if licznik == 3 {
        break;
    }
} until licznik == 5;
print(licznik);

print("--- 7. Instrukcja SWITCH ---");
var wybor = 2;
switch wybor {
    case 1: print("Wybrano jeden");
    case 2: print("Wybrano dwa");
    default: print("Inny wybor");
}

print("--- 8. Funkcje i rekurencja ---");
def silnia(n) {
    if n <= 1 {
        return 1;
    }
    return n * silnia(n - 1);
}
print(silnia(5));

print("--- 9. Wbudowane funkcje i indeksowanie ---");
var kat = 90;
print(sin(kat));

var MojaMacierz = [
    [10, 20],
    [30, 40]
];
print(MojaMacierz[1, 0]);